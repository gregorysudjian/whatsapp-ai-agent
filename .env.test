# Fake values for the test suite. Committed on purpose: nothing here is a
# secret, and tests must never load .env - that would point them at the real
# Graph credentials and the live conversation database.
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_BUSINESS_ACCOUNT_ID=000000000000000
WHATSAPP_ACCESS_TOKEN=test-access-token
WHATSAPP_VERIFY_TOKEN=test-verify-token
WHATSAPP_APP_SECRET=test-app-secret
GRAPH_API_VERSION=v23.0

ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=8192

DB_PATH=./data/test.db
DASHBOARD_TOKEN=test-dashboard-token
LOG_LEVEL=error
