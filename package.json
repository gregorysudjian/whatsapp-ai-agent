{
  "name": "whatsapp-ai-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "build:all": "npm run build && npm run build:web",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "pretest": "node -e \"for (const f of ['data/test.db','data/test.db-wal','data/test.db-shm']) require('fs').rmSync(f,{force:true})\"",
    "fake-webhook": "tsx --env-file=.env src/testing/cli-webhook.ts",
    "business": "tsx --env-file=.env src/cli/business.ts",
    "user": "tsx --env-file=.env src/cli/user.ts",
    "shots": "node --env-file=.env.test src/testing/shots.ts",
    "gen-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "test": "node --env-file=.env.test --import ./src/testing/setup.ts --test --test-concurrency=1 --test-reporter=spec \"src/**/*.test.ts\" \"web/src/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "express": "^5.1.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
