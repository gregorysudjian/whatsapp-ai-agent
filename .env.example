# ---- Encryption (REQUIRED) ----
# Encrypts every stored WhatsApp token and app secret. Generate with:
#   npm run gen-key
# Back it up somewhere safe: lose it and every client's credentials must be
# re-entered. Never commit it, never reuse it across environments.
APP_ENCRYPTION_KEY=

# ---- Meta WhatsApp Cloud API (default business only) ----
# Optional. These seed business #1 so a single-business install keeps working.
# Additional clients are added with `npm run business -- add` / `connect`, and
# their credentials live encrypted in the database, not here.
# Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# System User token (permanent). Temporary tokens expire in 24h - fine for day one.
WHATSAPP_ACCESS_TOKEN=
# Any random string you invent; you paste the same one into Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard > App Settings > Basic > App Secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

# ---- Anthropic ----
# Use ONE of these. Set only the one you have - a present-but-empty
# ANTHROPIC_API_KEY shadows the auth token in the SDK's credential chain.
# ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-opus-5
# Ceiling for the whole turn. Thinking tokens count against this, so a
# WhatsApp-sized cap would risk truncating mid-thought - replies are kept
# short by the system prompt, not by starving the budget.
ANTHROPIC_MAX_TOKENS=8192


# ---- Server ----
PORT=3000
LOG_LEVEL=info

# ---- Storage ----
# SQLite file backing message history (node:sqlite - no native dependency).
DB_PATH=./data/agent.db
# The dashboard uses per-person logins (npm run user -- bootstrap); the old
# shared DASHBOARD_TOKEN is gone and is ignored if still set.

# ---- Optional ----
# Points the WhatsApp client at a mock instead of the real Graph API.
# Leave unset in production.
# GRAPH_BASE_URL=

# ---- Google Calendar (optional) ----
# From Google Cloud > APIs & Services > Credentials; step by step in
# docs/google-calendar-setup.md. Leave empty and the Calendar tab says
# "not set up" - nothing calls Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback
