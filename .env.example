# ---- Meta WhatsApp Cloud API ----
# Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# System User token (permanent). Temporary tokens expire in 24h - fine for day one.
WHATSAPP_ACCESS_TOKEN=
# Any random string you invent; you paste the same one into Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard > App Settings > Basic > App Secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

# ---- Anthropic ----
# Use ONE of these. Set only the one you have - a present-but-empty
# ANTHROPIC_API_KEY shadows the auth token in the SDK's credential chain.
# ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-opus-5
# Ceiling on reply length. Support answers are short; this is not a target.
ANTHROPIC_MAX_TOKENS=1024
# Optional - overrides the default persona in src/agent/prompt.ts.
SYSTEM_PROMPT=

# ---- Server ----
PORT=3000
LOG_LEVEL=info

# ---- Storage & dashboard ----
# SQLite file backing message history (node:sqlite - no native dependency).
DB_PATH=./data/agent.db
# Gates /dashboard and /api. Leave blank and one is generated per boot and
# printed to the log; set it to keep a stable URL across restarts.
# Do NOT rely on "it's only on localhost": cloudflared runs locally, so every
# tunnelled request also arrives from 127.0.0.1.
DASHBOARD_TOKEN=
